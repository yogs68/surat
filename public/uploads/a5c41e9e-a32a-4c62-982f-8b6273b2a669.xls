                        <td>2</td>
                        <td>0</td>
                        <td>3</td>
                        <td>ON TIME</td>
                    </tr>
                                    </tbody>
    </table>
    
    <br><br>
    
    <!-- SHEET 4: Bottleneck -->
        <table>
        <thead>
            <tr>
                <th colspan="6" style="background-color: #E74C3C;">SURAT TERTAHAN (BOTTLENECK)</th>
            </tr>
            <tr>
                <th>No</th>
                <th>Nomor Surat</th>
                <th>Perihal</th>
                <th>Status</th>
                <th>Urgency</th>
