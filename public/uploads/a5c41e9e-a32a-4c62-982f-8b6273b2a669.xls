                        <td>URGENT</td>
                        <td>27/01/2026 08:40</td>
                        <td>Disetujui</td>
                        <td>24/01/2026 14:40</td>
                        <td>24/01/2026 14:44</td>
                        <td>0</td>
                    </tr>
                                    <tr>
                        <td>2</td>
                        <td>002/SRT/01/2026</td>
                        <td>pengajuan beli shuttlecock</td>
                        <td>Staff Bidang 1</td>
                        <td>NORMAL</td>
                        <td>31/01/2026 14:32</td>
                        <td>Disetujui</td>
                        <td>23/01/2026 22:48</td>
                        <td>23/01/2026 22:55</td>
                        <td>0</td>
                    </tr>
                                    <tr>
                        <td>3</td>
                        <td>001/SRT/01/2026</td>
                        <td>Pengajuan Beli Alat Gym</td>
                        <td>Staff Bidang 1</td>
                        <td>NORMAL</td>
                        <td>31/01/2026 14:32</td>
                        <td>Menunggu Waketum 3</td>
                        <td>23/01/2026 22:45</td>
                        <td>23/01/2026 22:45</td>
                        <td>3</td>
                    </tr>
                                    </tbody>
    </table>
    
    <br><br>
    
    <!-- SHEET 2: Summary KPI -->
    <table>
        <thead>
            <tr>
                <th colspan="2" style="background-color: #70AD47;">SUMMARY - KEY PERFORMANCE INDICATORS</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>Total Surat</strong></td>
                <td>3</td>
            </tr>
            <tr>
                <td><strong>Average Process Time</strong></td>
                <td>0 hari</td>
            </tr>
            <tr>
                <td><strong>On-Time Rate</strong></td>
                <td>100%</td>
            </tr>
            <tr>
                <td><strong>Overdue Rate</strong></td>
                <td>0%</td>
            </tr>
        </tbody>
    </table>
    
    <br><br>
    
    <!-- SHEET 3: Avg per Tahap -->
        <table>
        <thead>
            <tr>
                <th colspan="5" style="background-color: #FFC000;">RATA-RATA WAKTU PER TAHAP APPROVAL</th>
            </tr>
            <tr>
                <th>Tahap</th>
                <th>Jumlah Surat</th>
                <th>Rata-rata Waktu (Hari)</th>
                <th>SOP Standard (Hari)</th>
