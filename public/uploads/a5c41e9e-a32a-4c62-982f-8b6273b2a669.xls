                        <td>0</td>
                    </tr>
                                <!-- Total Row -->
                <tr style="background-color: #D5E8F7; font-weight: bold;">
                    <td>TOTAL</td>
                    <td>3</td>
                    <td>2</td>
                    <td>0</td>
                    <td>1</td>
                    <td>0</td>
                </tr>
                    </tbody>
    </table>
    
    <br><br>
    
    <!-- Footer -->
    <table class="header-section">
        <tr>
            <td>&nbsp;</td>
        </tr>
        <tr>
            <td><em>Catatan: Data ini diekspor dari Sistem Approval Surat untuk keperluan analisis dan audit.</em></td>
        </tr>
        <tr>
            <td><em>File ini dapat dibuka di Microsoft Excel atau diimpor ke Power BI untuk analisis lebih lanjut.</em></td>
        </tr>
    </table>
</body>
</html>