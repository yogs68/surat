<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #4472C4;
            color: white;
            font-weight: bold;
        }
        .header-section {
            margin-bottom: 20px;
        }
        .header-section td {
            border: none;
            padding: 5px;
        }
    </style>
</head>
<body>
    <!-- Header Info -->
    <table class="header-section">
        <tr>
            <td><strong>EXPORT DATA SURAT - SISTEM APPROVAL</strong></td>
        </tr>
        <tr>
            <td>Periode: 01 January 2026 s/d 27 January 2026</td>
        </tr>
        <tr>
            <td>Export Date: 27 January 2026 07:30:39</td>
        </tr>
        <tr>
            <td>Exported By: Auditor (Auditor)</td>
        </tr>
        <tr>
            <td>&nbsp;</td>
        </tr>
    </table>
    
    <!-- SHEET 1: Raw Data Surat -->
    <table>
        <thead>
            <tr>
                <th>No</th>
                <th>Nomor Surat</th>
                <th>Perihal</th>
                <th>Pembuat</th>
                <th>Urgency</th>
                <th>Deadline</th>
                <th>Status</th>
                <th>Tanggal Submit</th>
                <th>Tanggal Update</th>
                <th>Durasi Proses (Hari)</th>
            </tr>
        </thead>
        <tbody>
                                                                <tr>
                        <td>1</td>
                        <td>003/SRT/01/2026</td>
                        <td>Pembelian Karpet Lapangan Badminton</td>
